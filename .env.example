# Для локального запуска Compose установите CEZEOS_ALLOW_DEMO=1 при необходимости.
CEZEOS_REGION_NAME=CeZeOs
CEZEOS_HOST_PORT=4173
CEZEOS_ALLOW_DEMO=0
# CEZEOS_PUBLIC_ORIGIN=https://region.example.org
# CEZEOS_IMAGE=ghcr.io/owner/cezeos-region:latest
# CEZEOS_GOVERNANCE_HOME=1
# CEZEOS_GOVERNANCE_REGION_ID=ID_ОБЩЕГО_СЕРВЕРА_УПРАВЛЕНИЯ
# CEZEOS_PEERS=[{"origin":"https://other.example.org","id":"ID_ИЗ_МАНИФЕСТА"}]
# CEZEOS_TELEGRAM_CLIENT_ID=
# CEZEOS_TELEGRAM_CLIENT_SECRET=
# CEZEOS_ANDROID_SHA256=AA:BB:... (отпечаток сертификата подписи APK)
# CEZEOS_AQUAMARINE_ISSUER=https://aquamarine.example.org
# CEZEOS_AQUAMARINE_PUBLIC_KEY={"kty":"OKP","crv":"Ed25519","x":"PUBLIC_KEY"}
